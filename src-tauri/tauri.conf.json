{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BB AES67 Matrix",
  "version": "0.2.0",
  "identifier": "com.bennybolognino.bbaes67matrix",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BB AES67 Matrix",
        "width": 1500,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "BB Broadcast",
    "shortDescription": "Controllo, monitoraggio e routing AES67",
    "longDescription": "Applicazione Windows per discovery SAP/SDP, monitor RTP, PTP, registrazione, routing AES67 e controllo NMOS.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}